# Copy to .env for local use. On Render, set these in Dashboard > Environment.
DEC_API_TOKEN=change-me-to-a-long-random-string
GEMINI_API_KEY=
GROQ_API_KEY=
# Order of providers; the next one is used if the previous fails.
DEC_PROVIDERS=gemini,groq
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-20b
DEC_DB_PATH=/tmp/dec.db
